<resources>
    <!--
      Tema unico (sin variante -night): la interfaz es negra en cualquier dispositivo
      y con cualquier ajuste del sistema, por requerimiento operativo de campo.
    -->
    <style name="Theme.InspSeg" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/inspseg_black</item>
        <item name="android:colorBackground">@color/inspseg_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
